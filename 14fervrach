<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valentine's Surprise ❤️</title>
    <style>
        body {
            background-color: #ffdae0;
            margin: 0;
            font-family: 'Cairo', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
        }

        /* خلفية القلوب المتساقطة */
        .heart {
            position: absolute;
            top: -10px;
            color: #ff4d6d;
            font-size: 20px;
            animation: fall linear forwards;
            z-index: -1;
        }
        @keyframes fall { to { transform: translateY(105vh) rotate(360deg); } }

        .container {
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            text-align: center;
            width: 85%;
            max-width: 400px;
            border: 5px solid #ff4d6d;
            position: relative;
        }

        h1 { color: #d63384; font-size: 24px; }

        .couple-img {
            width: 100%;
            border-radius: 20px;
            margin-bottom: 20px;
            border: 3px solid #ff4d6d;
        }

        .buttons {
            display: flex;
            justify-content: space-around; /* مفرقين */
            align-items: center;
            margin-top: 40px;
            height: 100px;
        }

        button {
            padding: 15px 30px;
            font-size: 18px;
            font-weight: bold;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: 0.2s;
        }

        #yesBtn {
            background-color: #ff4d6d;
            color: white;
            z-index: 1000;
        }

        #noBtn {
            background-color: #8a8a8a;
            color: white;
            position: absolute; /* باش يهرب في الشاشة كاملة */
        }
    </style>
</head>
<body>

    <div class="container" id="mainCard">
        <h1>Will you be my Valentine? ❤️</h1>
        
        <img src="https://i.ibb.co/p66W4mS/IMG-3406.jpg" class="couple-img" alt="Us">

        <div class="buttons">
            <button id="yesBtn" onclick="celebrate()">Yes!</button>
            <button id="noBtn" onmouseover="moveNo()" onclick="moveNo()">No</button>
        </div>
    </div>

    <script>
        let yesSize = 18;
        
        function moveNo() {
            const btn = document.getElementById('noBtn');
            const yes = document.getElementById('yesBtn');
            
            // الفخ: كل ما حاولت تبرك على No، زر Yes كيكبر
            yesSize += 10;
            yes.style.fontSize = yesSize + 'px';
            yes.style.padding = (yesSize/2) + 'px ' + (yesSize) + 'px';

            // هروب زر No
            const x = Math.random() * (window.innerWidth - btn.offsetWidth);
            const y = Math.random() * (window.innerHeight - btn.offsetHeight);
            btn.style.left = x + 'px';
            btn.style.top = y + 'px';
        }

        function celebrate() {
            const card = document.getElementById('mainCard');
            card.innerHTML = `
                <h1 style="font-size: 35px;">I knew it! ❤️🎉</h1>
                <img src="https://media.giphy.com/media/K976VvI9I2j9m/giphy.gif" width="100%" style="border-radius:20px;">
                <h2 style="color:#d63384;">You are mine forever! 🌹</h2>
            `;
            setInterval(createHeart, 200);
        }

        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '❤️';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = Math.random() * 2 + 3 + 's';
            document.body.appendChild(heart);
            setTimeout(() => { heart.remove(); }, 5000);
        }
    </script>
</body>
</html>
